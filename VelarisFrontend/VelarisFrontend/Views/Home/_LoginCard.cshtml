@model VelarisFrontend.Models.LoginViewModel
@{ 
    ViewBag.Title = "Login";
}


<div class="container mt-5">
    <div class="card card-white mx-auto" style="max-width: 400px;">
        <h4>Log In</h4>

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.LabelFor(m => m.Username)
            @Html.ValidationMessageFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { @class = "input-box", placeholder = "Username" })

            @Html.LabelFor(m => m.Password)
            @Html.ValidationMessageFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "input-box", placeholder = "Password" })

            <div class="d-flex justify-content-between align-items-center">
                <a href="/Auth/Register" class="text-light-grey">Register</a>
                <button type="submit" class="btn btn-black">Log in</button>
            </div>
        }
    </div>
</div>